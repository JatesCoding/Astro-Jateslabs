---
import Navbar from "../components/Navbar.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cal+Sans&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <title>JatesLabs</title>
  </head>
  <body>
    <Navbar />
    <slot />
  </body>
</html>

<style is:global>
  @import url("https://fonts.googleapis.com/css2?family=Cal+Sans&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap");

  @layer base {
    html,
    body {
      margin: 0;
      width: 100%;
      height: 100%;
    }

    h1 {
      font-family: "Cal Sans", sans-serif;
      font-weight: 400;
      font-style: normal;
    }
    h1.massive {
      font-size: 4rem;
    }
    h2 {
      font-family: "Cal Sans", sans-serif;
      font-weight: 400;
      font-style: normal;
    }
    a {
      text-decoration: None;
      color: inherit;
      font-family: "Cal Sans", sans-serif;
      font-weight: 400;
    }
  }
</style>
