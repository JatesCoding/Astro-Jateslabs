---
import Heroimage from "../assets/HeroImage.avif";
---

<section
  class="w-full bg-white border-t-2 border-blue-400 py-10 px-6 sm:px-10 lg:px-16"
>
  <div
    class="max-w-6xl mx-auto flex flex-row md:flex-row md:items-start gap-10"
  >
    <img
      src={Heroimage.src}
      alt="JatesLabs"
      class="w-1/2 md:w-full object-contain rounded-lg shadow-lg"
    />
    <div class="flex flex-col items-start gap-4">
      <h1 class="text-10xl sm:text-8xl font-bold text-blue-400">
        Hello!<br /><span class="text-gray-900">I'm J.T.</span>
      </h1>
      <p class="sm:text-lg text-gray-500">Your go-to IT guy!</p>
    </div>
  </div>
</section>
