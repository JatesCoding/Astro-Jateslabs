---
import Hero_image from "../assets/HeroImage.avif";
---

<section class="section">
  <div
    class="container-x flex flex-col md:flex-row items-center justify-center"
  >
    <img
      src={Hero_image.src}
      alt="JatesLabs Logo"
      class="w-full md:w-1/2 object-contain rounded-lg shadow-lg"
    />
    <div
      class="flex flex-col items-center md:items-start gap-4 p-10 justify-center"
    >
      <h1 class="massive text-center md:text-left text-blue-500 drop-shadow-lg">
        Hello! <br />
        <span class="text-gray-900 drop-shadow-lg">I'm J.T.</span>
      </h1>
      <p class="subtitle drop-shadow-lg">Your go-to IT guy!</p>
      <a href="#projects" class="btn-primary">View My Projects</a>
    </div>
  </div>
</section>
