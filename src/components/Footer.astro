---
import jatesLabsLogo from "../assets/logo.svg";
---

<footer
  class="w-full bg-white border-t-2 border-blue-400 py-10 px-6 sm:px-10 lg:px-16"
>
  <div
    class="max-w-6xl mx-auto flex flex-col md:flex-row md:items-start justify-between gap-10"
  >
    <!-- Left: Brand & Tagline -->
    <div class="flex flex-col items-start gap-4">
      <a href="/" class="flex gap-2 items-center">
        <img
          src={jatesLabsLogo.src}
          alt="JatesLabs"
          class="h-12 w-auto object-contain"
        />
        <h1 class="text-4xl text-blue-400 mt-2">
          Jates<span class="text-gray-500">Labs</span>
        </h1>
      </a>
      <p class="text-base sm:text-lg font-bold text-gray-700">
        <span class="text-blue-400">Happy</span> to Help.
      </p>
    </div>

    <!-- Right: Navigation Columns -->
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-8 sm:gap-12 md:gap-16">
      <!-- Main Pages -->
      <div>
        <h2 class="text-blue-400">Main Pages</h2>
        <ul class="flex flex-col gap-2.5">
          <li>
            <a
              href="/"
              class="text-gray-500 hover:text-gray-800 text-sm font-medium transition-colors"
            >
              Home
            </a>
          </li>
          <li>
            <a
              href="/contact"
              class="text-gray-500 hover:text-gray-800 text-sm font-medium transition-colors"
            >
              Contact
            </a>
          </li>
        </ul>
      </div>

      <!-- CMS Pages -->
      <div>
        <h3 class="text-blue-400 font-bold text-base mb-3 sm:mb-4">
          CMS Pages
        </h3>
        <ul class="flex flex-col gap-2.5">
          <li>
            <a
              href="/projects"
              class="text-gray-500 hover:text-gray-800 text-sm font-medium transition-colors"
            >
              Projects
            </a>
          </li>
        </ul>
      </div>

      <!-- Follow Me -->
      <div>
        <h3 class="text-blue-400 font-bold text-base mb-3 sm:mb-4">
          Follow Me
        </h3>
        <ul class="flex flex-col gap-2.5">
          <li>
            <a
              href="https://instagram.com"
              target="_blank"
              rel="noopener noreferrer"
              class="text-gray-500 hover:text-gray-800 text-sm font-medium transition-colors"
            >
              Instagram
            </a>
          </li>
          <li>
            <a
              href="https://facebook.com"
              target="_blank"
              rel="noopener noreferrer"
              class="text-gray-500 hover:text-gray-800 text-sm font-medium transition-colors"
            >
              Facebook
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</footer>
