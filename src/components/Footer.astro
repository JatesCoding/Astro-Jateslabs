---
import jatesLabsLogo from "../assets/logotext.svg";
---

<footer
  class="w-full bg-white border-t-2 border-blue-400 py-10 px-6 sm:px-10 lg:px-16"
>
  <div
    class="max-w-6xl mx-auto flex flex-col md:flex-row md:items-start justify-between gap-10"
  >
    <!-- Left: Brand & Tagline -->
    <div class="flex flex-col items-start gap-4">
      <a href="/" class="flex gap-2 items-center">
        <img
          src={jatesLabsLogo.src}
          alt="JatesLabs"
          class="h-14 w-auto object-contain"
        />
      </a>
      <p class="text-base sm:text-lg text-gray-500">
        <span class="text-blue-400">Your go to</span> IT guy.
      </p>
    </div>

    <!-- Right: Navigation Columns -->
    <div
      class="grid grid-cols-2 sm:grid-cols-3 gap-8 sm:gap-12 md:gap-16 lg:gap-30"
    >
      <!-- Main Pages -->
      <div>
        <h3 class="text-blue-400">Main Pages</h3>
        <ul class="flex flex-col gap-2.5">
          <li>
            <a
              href="/"
              class="text-gray-400 hover:text-sky-500 text-sm font-medium transition-colors"
            >
              Home
            </a>
          </li>
          <li>
            <a
              href="/contact"
              class="text-gray-400 hover:text-sky-500 text-sm font-medium transition-colors"
            >
              Contact
            </a>
          </li>
        </ul>
      </div>

      <!-- CMS Pages -->
      <div>
        <h3 class="text-blue-400">CMS Pages</h3>
        <ul class="flex flex-col gap-2.5">
          <li>
            <a
              href="/projects"
              class="text-gray-400 hover:text-sky-500 text-sm font-medium transition-colors"
            >
              Projects
            </a>
          </li>
        </ul>
      </div>

      <!-- Follow Me -->
      <div>
        <h3 class="text-blue-400">Follow Me</h3>
        <ul class="flex flex-col gap-2.5">
          <li>
            <a
              href="https://instagram.com"
              target="_blank"
              rel="noopener noreferrer"
              class="text-gray-400 hover:text-sky-500 text-sm font-medium transition-colors"
            >
              Instagram
            </a>
          </li>
          <li>
            <a
              href="https://facebook.com"
              target="_blank"
              rel="noopener noreferrer"
              class="text-gray-400 hover:text-sky-500 text-sm font-medium transition-colors"
            >
              Facebook
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</footer>
