---
import jatesLabsLogo from "../assets/logotext.svg";
---

<header class="sticky top-0 z-50 w-full border-b border-gray-200 bg-white">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-3">
    <a href="/" class="flex items-center gap-2 text-gray-900 no-underline">
      <img src={jatesLabsLogo.src} alt="JatesLabs Logo" width="150" />
    </a>

    <button
      class="group hidden h-4.5 w-6 cursor-pointer flex-col justify-between border-none bg-transparent p-0 max-md:flex"
      id="menuToggle"
      data-active="false"
      aria-label="Toggle navigation"
      aria-expanded="false"
    >
      <span
        class="h-0.5 w-full bg-gray-900 transition-all duration-300 group-data-[active=true]:translate-y-2 group-data-[active=true]:rotate-45"
      ></span>
      <span
        class="h-0.5 w-full bg-gray-900 transition-all duration-300 group-data-[active=true]:opacity-0"
      ></span>
      <span
        class="h-0.5 w-full bg-gray-900 transition-all duration-300 group-data-[active=true]:-translate-y-2 group-data-[active=true]:-rotate-45"
      ></span>
    </button>

    <div
      id="navbarCollapse"
      data-active="false"
      class="flex grow justify-between items-center max-md:items-start md:ml-12 max-md:absolute max-md:top-full max-md:left-0 max-md:hidden max-md:w-full max-md:flex-col max-md:border-b max-md:border-gray-200 max-md:bg-white max-md:shadow-md max-md:data-[active=true]:flex"
    >
      <nav
        class="mx-auto flex gap-8 max-md:w-full max-md:flex-col max-md:gap-1"
      >
        <a
          href="#about"
          class="text-gray-600 transition-colors max-md:p-3 hover:text-blue-500 max-md:border-b-2"
          >About</a
        >
        <span class="text-gray-400 max-md:hidden">|</span>
        <a
          href="#skills"
          class="text-gray-600 transition-colors max-md:p-3 hover:text-blue-500 max-md:border-b-2"
          >Skills</a
        >
        <span class="text-gray-400 max-md:hidden">|</span>
        <a
          href="#contact"
          class="text-gray-600 transition-colors max-md:p-3 hover:text-blue-500 max-md:border-b-2"
          >Contact Me</a
        >
      </nav>

      <a
        href="#projects"
        class="shadow-md rounded-full bg-blue-400 px-5 py-2 max-md:m-4 font-medium text-white transition-colors border-blue-400 border-2 hover:text-gray-500 hover:bg-white hover:border-2"
        >View My Projects</a
      >
    </div>
  </div>
</header>

<script>
  const menuToggle = document.getElementById("menuToggle");
  const navbarCollapse = document.getElementById("navbarCollapse");

  if (menuToggle && navbarCollapse) {
    menuToggle.addEventListener("click", () => {
      const isActive = menuToggle.getAttribute("data-active") !== "true";
      menuToggle.setAttribute("data-active", String(isActive));
      navbarCollapse.setAttribute("data-active", String(isActive));
      menuToggle.setAttribute("aria-expanded", String(isActive));
    });
  }
</script>
